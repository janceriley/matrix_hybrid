{
  "name": "One Desk",
  "version": "0.1.1",
  "modes": ["light", "dark"],

  "color": {
    "canvas":      {"group": "chrome", "light": "#f2f4f7", "dark": "#0c1218", "use": "Window and page background"},
    "surface":     {"group": "chrome", "light": "#ffffff", "dark": "#121a23", "use": "Panels, grids, tables and chart surfaces"},
    "raised":      {"group": "chrome", "light": "#f7f8fa", "dark": "#17212c", "use": "Headers, rails and control strips"},
    "sunken":      {"group": "chrome", "light": "#eaedf1", "dark": "#0e151c", "use": "Wells, inactive tabs and code"},
    "rule":        {"group": "chrome", "light": "#dce1e7", "dark": "#253140", "use": "Hairlines and gridlines"},
    "rule_strong": {"group": "chrome", "light": "#b6bfca", "dark": "#3b4a5c", "use": "Control borders, axis lines and header lines"},
    "ink":         {"group": "chrome", "light": "#17212f", "dark": "#e6ebf1", "use": "Text and the market mid"},
    "ink_2":       {"group": "chrome", "light": "#475467", "dark": "#b4bfcc", "use": "Secondary text"},
    "muted":       {"group": "chrome", "light": "#667085", "dark": "#8b98a9", "use": "Labels, captions and axis ticks"},
    "faint":       {"group": "chrome", "light": "#98a2b3", "dark": "#5e6b7b", "use": "Disabled text and placeholders"},

    "navy":        {"group": "accent", "light": "#0d3b70", "dark": "#8fb3e8", "use": "Primary buttons, active tab, selection and the playhead. Never data."},
    "navy_hover":  {"group": "accent", "light": "#082b52", "dark": "#b1cbf0", "use": "Hovered or pressed accent"},
    "navy_tint":   {"group": "accent", "light": "#e6eef8", "dark": "#18283d", "use": "Selected cell and active tab chip"},
    "on_navy":     {"group": "accent", "light": "#ffffff", "dark": "#0c1218", "use": "Text and icons on navy"},
    "focus":       {"group": "accent", "light": "#2a69ac", "dark": "#8fb3e8", "use": "Keyboard focus ring"},

    "up":          {"group": "data", "light": "#157a3a", "dark": "#46b46e", "use": "Gain, buy, exit buy and the lower endpoint"},
    "up_tint":     {"group": "data", "light": "#e2f2e7", "dark": "#11291b", "use": "Exit-buy fill and gain tint"},
    "down":        {"group": "data", "light": "#b42318", "dark": "#f06a5e", "use": "Loss, sell, fees and the upper endpoint"},
    "down_tint":   {"group": "data", "light": "#fbe8e6", "dark": "#33181a", "use": "Exit-sell fill and loss tint"},
    "count":       {"group": "data", "light": "#2a78d6", "dark": "#3987e5", "use": "Neutral quantities and rates, never money. Same as chart slot 1."},
    "model":       {"group": "data", "light": "#6a4bb5", "dark": "#c39af5", "use": "Fair value and methodology output"},
    "model_tint":  {"group": "data", "light": "#efeafa", "dark": "#221b38", "use": "Model band fill"},
    "quote":       {"group": "data", "light": "#44566c", "dark": "#b8bcc2", "use": "Bid and ask, told apart by side and marker"},
    "quote_2":     {"group": "data", "light": "#8794a6", "dark": "#5f7086", "use": "Second quote tone: ask bars and the spread bracket"},
    "itm":         {"group": "data", "light": "#e8ebef", "dark": "#1a232e", "use": "In-the-money shading"},

    "ok":          {"group": "status", "light": "#157a3a", "dark": "#46b46e", "use": "Live, ready, passed. Same hue as up, used only in tags."},
    "warn":        {"group": "status", "light": "#a15c07", "dark": "#f0b04e", "use": "Needs you, or work in progress"},
    "warn_tint":   {"group": "status", "light": "#fcf0d9", "dark": "#33260f", "use": "Background of tags that need you"},
    "bad":         {"group": "status", "light": "#b42318", "dark": "#f06a5e", "use": "Failed, blocked, error. Same hue as down, used only in tags."},
    "bad_tint":    {"group": "status", "light": "#fbe8e6", "dark": "#33181a", "use": "Background of failed tags"},
    "off":         {"group": "status", "light": "#8590a0", "dark": "#7a8798", "use": "Offline, idle, paused"},
    "rec":         {"group": "status", "light": "#d92d20", "dark": "#ff5c50", "use": "The recording dot"},
    "hatch":       {"group": "status", "light": "#c3cad3", "dark": "#3a4757", "use": "Hatch lines over untrusted data: stale, failed, missing"},
    "stripe":      {"group": "status", "light": "#e8a317", "dark": "#d9961c", "use": "Demo-data stripes"},
    "stripe_2":    {"group": "status", "light": "#17212f", "dark": "#0c1218", "use": "Second demo-stripe color"}
  },

  "series": {
    "categorical": {
      "use": "Identity only (which series). Never mix with up/down in one chart. Lines and bars: up to 5 series. Scatter, maps and small multiples: up to 3.",
      "light": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4"],
      "dark":  ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181"],
      "max_adjacent": 5,
      "max_all_pairs": 3
    },
    "sequential": {
      "use": "Magnitude. One hue, light to dark; dark mode runs dark to light.",
      "light": ["#cde2fb", "#b7d3f6", "#9ec5f4", "#86b6ef", "#6da7ec", "#3987e5", "#2a78d6", "#1c5cab", "#184f95", "#0d366b"]
    },
    "diverging_mid": {
      "use": "Neutral midpoint between down (loss) and up (gain) on diverging scales",
      "light": "#eef1f4",
      "dark": "#26303c"
    }
  },

  "font": {
    "ui": {
      "use": "Sentences: buttons, messages, descriptions, menus",
      "css": ["Segoe UI Variable Text", "Segoe UI Variable", "Segoe UI", "system-ui", "-apple-system", "Helvetica Neue", "Arial", "sans-serif"],
      "tk": [{"family": "Segoe UI Variable Text", "weight": "normal"}, {"family": "Segoe UI", "weight": "normal"}],
      "weight": 400
    },
    "ui_strong": {
      "use": "Emphasis inside sentences, active tabs",
      "css": ["Segoe UI Variable Text", "Segoe UI Variable", "Segoe UI", "system-ui", "-apple-system", "Helvetica Neue", "Arial", "sans-serif"],
      "tk": [{"family": "Segoe UI Variable Text Semibold", "weight": "normal"}, {"family": "Segoe UI Semibold", "weight": "normal"}, {"family": "Segoe UI", "weight": "bold"}],
      "weight": 600
    },
    "display": {
      "use": "Window, page and section titles",
      "css": ["Segoe UI Variable Display", "Segoe UI Variable", "Segoe UI", "system-ui", "-apple-system", "Helvetica Neue", "Arial", "sans-serif"],
      "tk": [{"family": "Segoe UI Variable Display Semib", "weight": "normal"}, {"family": "Segoe UI Semibold", "weight": "normal"}, {"family": "Segoe UI", "weight": "bold"}],
      "weight": 600
    },
    "label": {
      "use": "Caps labels, column heads, status words and big readouts",
      "css": ["Bahnschrift", "DIN Alternate", "Barlow Semi Condensed", "Arial Narrow", "sans-serif"],
      "tk": [{"family": "Bahnschrift SemiBold SemiConden", "weight": "normal"}, {"family": "Bahnschrift SemiBold", "weight": "normal"}, {"family": "Segoe UI Semibold", "weight": "normal"}, {"family": "Segoe UI", "weight": "bold"}],
      "weight": 600,
      "stretch": "87.5%",
      "letter_spacing_em": 0.08
    },
    "num": {
      "use": "Numbers that line up or change: prices, strikes, sizes, P&L, times, counts",
      "css": ["Cascadia Mono", "Cascadia Code", "Consolas", "ui-monospace", "Menlo", "monospace"],
      "tk": [{"family": "Cascadia Mono", "weight": "normal"}, {"family": "Consolas", "weight": "normal"}, {"family": "Courier New", "weight": "normal"}],
      "weight": 400
    },
    "num_strong": {
      "use": "Emphasised numbers: signals, exit prices, the selected value",
      "css": ["Cascadia Mono", "Cascadia Code", "Consolas", "ui-monospace", "Menlo", "monospace"],
      "tk": [{"family": "Cascadia Mono SemiBold", "weight": "normal"}, {"family": "Consolas", "weight": "bold"}, {"family": "Courier New", "weight": "bold"}],
      "weight": 600
    }
  },

  "size": {
    "type": {
      "caption": {"px": 11, "pt": 8, "use": "Captions, status bar, caps labels"},
      "body":    {"px": 12, "pt": 9, "use": "Body text, grid cells, tables"},
      "control": {"px": 13, "pt": 10, "use": "Buttons, inputs, tabs"},
      "title":   {"px": 15, "pt": 11, "use": "Panel and dialog titles"},
      "heading": {"px": 20, "pt": 15, "use": "Section headings"},
      "readout": {"px": 27, "pt": 20, "use": "Big readouts such as net P&L"}
    },
    "space": [4, 8, 12, 16, 24],
    "radius": {"tk": 0, "web": 3, "window": 7},
    "rule": {"hairline": 1, "strong": 2},
    "height": {"app_bar": 40, "control_strip": 36, "status_bar": 24, "matrix_row": 24, "table_row": 26},
    "row_padding": {"matrix": 8, "table": 10},
    "rail": 240
  },

  "glyph": {
    "on": "●",
    "off": "○",
    "working": "◐",
    "retrying": "↻",
    "attention": "⚠",
    "failed": "✕",
    "error": "!",
    "sharing": "⮂",
    "missing": "—"
  },

  "format": {
    "missing": "—",
    "separator": " · ",
    "ellipsis": "…",
    "minus": "−",
    "width_prefix": "W"
  }
}
